{
  "id": "no.kristo.ki-pultforsterker",
  "version": "2.6.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Pultforsterker",
    "no": "Pultforsterker"
  },
  "description": {
    "en": "Control the desk amplifier: power, input (AirPlay/Bluetooth/AUX/USB), volume, now playing",
    "no": "Styr pultforsterkeren: strøm, kilde (AirPlay/Bluetooth/AUX/USB), volum, spiller nå"
  },
  "category": [
    "music"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "Sebastian Kristo",
    "email": "sebastian@kristo.no"
  },
  "brandColor": "#2c2d30",
  "drivers": [
    {
      "id": "pultforsterker",
      "name": {
        "en": "Pultforsterker",
        "no": "Pultforsterker"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "volume_set",
        "volume_mute",
        "speaker_prev",
        "speaker_playing",
        "speaker_next",
        "speaker_track",
        "speaker_artist",
        "speaker_position",
        "speaker_duration",
        "speaker_album",
        "ki_input",
        "ki_preset",
        "ki_loudness",
        "ki_loudness_level",
        "ki_voice"
      ],
      "capabilitiesOptions": {
        "speaker_playing": {
          "setable": true
        },
        "speaker_track": {
          "title": {
            "en": "Title",
            "no": "Tittel"
          }
        },
        "speaker_artist": {
          "title": {
            "en": "Artist",
            "no": "Artist"
          }
        },
        "speaker_position": {
          "setable": false
        },
        "speaker_duration": {
          "setable": false
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "kipultamp",
      "images": {
        "small": "/drivers/pultforsterker/assets/images/small.png",
        "large": "/drivers/pultforsterker/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "IP address",
            "no": "IP-adresse"
          },
          "value": ""
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "value": 8765
        }
      ]
    }
  ],
  "discovery": {
    "kipultamp": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "kipultamp",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}",
      "conditions": [
        [
          {
            "field": "txt.type",
            "match": {
              "type": "string",
              "value": "pultforsterker"
            }
          }
        ]
      ]
    }
  },
  "capabilities": {
    "ki_input": {
      "type": "enum",
      "title": {
        "en": "Input",
        "no": "Kilde"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/icon.svg",
      "values": [
        {
          "id": "radio",
          "title": {
            "en": "Radio",
            "no": "Radio"
          }
        },
        {
          "id": "airplay",
          "title": {
            "en": "AirPlay",
            "no": "AirPlay"
          }
        },
        {
          "id": "bt",
          "title": {
            "en": "Bluetooth",
            "no": "Bluetooth"
          }
        },
        {
          "id": "aux",
          "title": {
            "en": "AUX",
            "no": "AUX"
          }
        },
        {
          "id": "usb",
          "title": {
            "en": "USB",
            "no": "USB"
          }
        }
      ]
    },
    "ki_loudness": {
      "type": "boolean",
      "title": {
        "en": "Loudness",
        "no": "Loudness"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/icon.svg"
    },
    "ki_loudness_level": {
      "type": "number",
      "title": {
        "en": "Loudness level",
        "no": "Loudness-styrke"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 0,
      "max": 10,
      "step": 1,
      "units": {
        "en": "dB"
      }
    },
    "ki_voice": {
      "type": "boolean",
      "title": {
        "en": "Voice prompts",
        "no": "Talemeldinger"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/icon.svg"
    },
    "ki_preset": {
      "type": "enum",
      "title": {
        "en": "Radio station",
        "no": "Radiokanal"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/icon.svg",
      "values": [
        {
          "id": "1",
          "title": {
            "en": "Station 1",
            "no": "Kanal 1"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Station 2",
            "no": "Kanal 2"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "Station 3",
            "no": "Kanal 3"
          }
        },
        {
          "id": "4",
          "title": {
            "en": "Station 4",
            "no": "Kanal 4"
          }
        },
        {
          "id": "5",
          "title": {
            "en": "Station 5",
            "no": "Kanal 5"
          }
        },
        {
          "id": "6",
          "title": {
            "en": "Station 6",
            "no": "Kanal 6"
          }
        }
      ]
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "ki_started_playing",
        "title": {
          "en": "Started playing",
          "no": "Begynte å spille"
        },
        "tokens": [
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title",
              "no": "Tittel"
            }
          },
          {
            "name": "artist",
            "type": "string",
            "title": {
              "en": "Artist",
              "no": "Artist"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          }
        ]
      },
      {
        "id": "ki_stopped_playing",
        "title": {
          "en": "Stopped playing",
          "no": "Sluttet å spille"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          }
        ]
      },
      {
        "id": "ki_input_changed",
        "title": {
          "en": "Input changed",
          "no": "Kilde endret"
        },
        "tokens": [
          {
            "name": "input",
            "type": "string",
            "title": {
              "en": "Input",
              "no": "Kilde"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "ki_is_playing",
        "title": {
          "en": "Is !{{playing|not playing}}",
          "no": "Spiller !{{|ikke}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          }
        ]
      },
      {
        "id": "ki_input_is",
        "title": {
          "en": "Input !{{is|is not}}",
          "no": "Kilde !{{er|er ikke}}"
        },
        "titleFormatted": {
          "en": "Input !{{is|is not}} [[input]]",
          "no": "Kilde !{{er|er ikke}} [[input]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          },
          {
            "type": "dropdown",
            "name": "input",
            "values": [
              {
                "id": "radio",
                "label": {
                  "en": "Radio",
                  "no": "Radio"
                }
              },
              {
                "id": "airplay",
                "label": {
                  "en": "AirPlay",
                  "no": "AirPlay"
                }
              },
              {
                "id": "bt",
                "label": {
                  "en": "Bluetooth",
                  "no": "Bluetooth"
                }
              },
              {
                "id": "aux",
                "label": {
                  "en": "AUX",
                  "no": "AUX"
                }
              },
              {
                "id": "usb",
                "label": {
                  "en": "USB",
                  "no": "USB"
                }
              }
            ],
            "title": {
              "en": "Source",
              "no": "Kilde"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "ki_toggle",
        "title": {
          "en": "Toggle power",
          "no": "Veksle strøm"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          }
        ]
      },
      {
        "id": "ki_set_input",
        "title": {
          "en": "Select input",
          "no": "Velg kilde"
        },
        "titleFormatted": {
          "en": "Select input [[input]]",
          "no": "Velg kilde [[input]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          },
          {
            "type": "dropdown",
            "name": "input",
            "values": [
              {
                "id": "radio",
                "label": {
                  "en": "Radio",
                  "no": "Radio"
                }
              },
              {
                "id": "airplay",
                "label": {
                  "en": "AirPlay",
                  "no": "AirPlay"
                }
              },
              {
                "id": "bt",
                "label": {
                  "en": "Bluetooth",
                  "no": "Bluetooth"
                }
              },
              {
                "id": "aux",
                "label": {
                  "en": "AUX",
                  "no": "AUX"
                }
              },
              {
                "id": "usb",
                "label": {
                  "en": "USB",
                  "no": "USB"
                }
              }
            ],
            "title": {
              "en": "Source",
              "no": "Kilde"
            }
          }
        ]
      },
      {
        "id": "ki_bt_pair",
        "title": {
          "en": "Start Bluetooth pairing",
          "no": "Start Bluetooth-parring"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          }
        ]
      },
      {
        "id": "ki_set_loudness",
        "title": {
          "en": "Set loudness",
          "no": "Sett loudness"
        },
        "titleFormatted": {
          "en": "Loudness [[on]] at level [[level]]",
          "no": "Loudness [[on]] på styrke [[level]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          },
          {
            "type": "dropdown",
            "name": "on",
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "off",
                  "no": "av"
                }
              }
            ],
            "title": {
              "en": "Loudness",
              "no": "Loudness"
            }
          },
          {
            "type": "range",
            "name": "level",
            "min": 0,
            "max": 10,
            "step": 1,
            "label": "dB",
            "title": {
              "en": "Level (dB)",
              "no": "Nivå (dB)"
            }
          }
        ]
      },
      {
        "id": "ki_transport",
        "title": {
          "en": "Playback: [[action]]",
          "no": "Avspilling: [[action]]"
        },
        "titleFormatted": {
          "en": "Playback: [[action]]",
          "no": "Avspilling: [[action]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker"
          },
          {
            "type": "dropdown",
            "name": "action",
            "title": {
              "en": "Action",
              "no": "Handling"
            },
            "values": [
              {
                "id": "playpause",
                "label": {
                  "en": "Play/pause",
                  "no": "Spill/pause"
                }
              },
              {
                "id": "play",
                "label": {
                  "en": "Play",
                  "no": "Spill"
                }
              },
              {
                "id": "pause",
                "label": {
                  "en": "Pause",
                  "no": "Pause"
                }
              },
              {
                "id": "next",
                "label": {
                  "en": "Next track",
                  "no": "Neste spor"
                }
              },
              {
                "id": "previous",
                "label": {
                  "en": "Previous track",
                  "no": "Forrige spor"
                }
              },
              {
                "id": "stop",
                "label": {
                  "en": "Stop",
                  "no": "Stopp"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "ki_play_preset",
        "title": {
          "en": "Play radio station",
          "no": "Spill radiokanal"
        },
        "titleFormatted": {
          "en": "Play radio station [[preset]]",
          "no": "Spill radiokanal [[preset]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          },
          {
            "type": "autocomplete",
            "name": "preset",
            "title": {
              "en": "Station",
              "no": "Kanal"
            },
            "placeholder": {
              "en": "NRK P1",
              "no": "NRK P1"
            }
          }
        ]
      },
      {
        "id": "ki_save_preset",
        "title": {
          "en": "Save current radio station",
          "no": "Lagre radiokanalen som spiller"
        },
        "titleFormatted": {
          "en": "Save current station as [[n]]",
          "no": "Lagre kanalen som spiller som [[n]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pultforsterker",
            "title": {
              "en": "Device",
              "no": "Enhet"
            }
          },
          {
            "type": "dropdown",
            "name": "n",
            "title": {
              "en": "Number",
              "no": "Plass"
            },
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "1",
                  "no": "1"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "2",
                  "no": "2"
                }
              },
              {
                "id": "3",
                "label": {
