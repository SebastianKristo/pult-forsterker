# Kopieres til /etc/ki-amp.env
KI_AMP_NAME=Pultforsterker
KI_AMP_PORT=8765
RELAY_ACTIVE_LOW=1
# Øvre grense for digitalpot (0-99) ved 100 % volum. 85 = trygt for 6 ohm / 5-40 W-høyttalere på 24 V.
KI_AMP_MAX_TAP=85
# CamillaDSP (loudness/digitalt volum for AirPlay, BT, USB)
KI_AMP_DSP_WS=ws://127.0.0.1:1234
KI_AMP_DSP_CAPTURE=hw:Loopback,1
KI_AMP_DSP_PLAYBACK=hw:sndrpihifiberry
# Valgfritt – tom = MQTT av (HA-integrasjonen og Homey-appen trenger det ikke)
MQTT_HOST=
MQTT_USER=
MQTT_PASS=
