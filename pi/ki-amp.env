# Kopieres til /etc/ki-amp.env
KI_AMP_NAME=Pultforsterker
KI_AMP_PORT=8765
RELAY_ACTIVE_LOW=1
# Øvre grense for digitalpot (0-99) ved 100 % volum. 85 = trygt for 6 ohm / 5-40 W-høyttalere på 24 V.
KI_AMP_MAX_TAP=85
# Valgfritt – tom = MQTT av (HA-integrasjonen og Homey-appen trenger det ikke)
MQTT_HOST=
MQTT_USER=
MQTT_PASS=
