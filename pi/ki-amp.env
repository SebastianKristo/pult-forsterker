# Kopieres til /etc/ki-amp.env
KI_AMP_NAME=Pultforsterker
KI_AMP_PORT=8765
# modules = modulbygget (XH-M562 + X9C + relékort), main = Pultforsterker hovedkort rev B
KI_AMP_BOARD=modules
RELAY_ACTIVE_LOW=1
# Øvre grense for digitalpot (0-99) ved 100 % volum. 85 = trygt for 6 ohm / 5-40 W-høyttalere på 24 V.
KI_AMP_MAX_TAP=85
# CamillaDSP (loudness/digitalt volum for AirPlay, BT, USB)
KI_AMP_DSP_WS=ws://127.0.0.1:1234
KI_AMP_DSP_CAPTURE=hw:Loopback,1
KI_AMP_DSP_PLAYBACK=hw:sndrpihifiberry
# KI_AMP_DSP_FORMAT=S16LE   # bare i testmodus (KI_AMP_OUT=headphones – 3,5 mm på Pi 4)
# 1 = mono: CamillaDSP summerer L+R til begge kanalene (Skjold Radio med ett element). 0/tom = stereo
KI_AMP_MONO=0
# Valgfritt – tom = MQTT av (HA-integrasjonen og Homey-appen trenger det ikke)
MQTT_HOST=
MQTT_USER=
MQTT_PASS=


# Bytt kilde automatisk når AirPlay/Bluetooth begynner å spille (1 = på, 0 = av)
KI_AMP_AUTO_INPUT=1
# 1 = miks digitale kilder (AirPlay, Bluetooth, USB og Radio kan spille samtidig). Kan også slås av/på i HA/Homey.
KI_AMP_MIX=0
# Hovedkortet: fast analog dempning i PGA2311 (dB). -9 = full digital styrke gir akkurat ikke klipping i TPA3116 ved 24 V
KI_AMP_PGA_DB=-9
# 1 = demp høyttalerne når hodetelefoner plugges i front-jacken (hovedkortet). Kan også slås av/på i HA/Homey.
KI_AMP_HP_AUTOMUTE=1
# 1 hvis jack-deteksjonen er koblet motsatt (lav = plugget i)
KI_AMP_HP_DET_INV=0
# Stemmeprofil for talemeldingene (kan også byttes i HA/Homey): en = engelsk AI-stemme, no = norsk, trondersk = trøndersk
KI_AMP_VOICE_PROFILE=en
# USB-delingsswitch (Ugreen): GPIO som trykker knappen via PC817 (tom = av), GPIO som leser PC 1-LED via PC817,
# hvilket nivå på avlesningen som betyr PC 1 (low/high), og navn på de to PC-ene
KI_AMP_USBSW_PULSE=
# opto = via PC817 (anbefalt). direct = knappens ledning rett på GPIO-en, GND til Pi GND (kun hvis knappen har ≤ 3,3 V)
KI_AMP_USBSW_MODE=opto
KI_AMP_USBSW_SENSE=
KI_AMP_USBSW_SENSE_PC1=low
KI_AMP_USBSW_NAMES=PC 1,PC 2
# 1 = frontknappene omfordeles: AIRPLAY-knappen blir «PC 1/2», BT-knappen blir «AIRPLAY/BT» (hold 2 s = BT-parring)
KI_AMP_USBSW_FRONT=0

# Lyrion Music Server (radio med kanal 1–6, stasjonsbilder). IP til LMS – tom = finn automatisk.
KI_AMP_LMS_SERVER=
# KI_AMP_POWER_PIN=17   # power-knappen (til GND) på denne GPIO-en (BCM) – hovedkortet uten MCP23017 bruker ellers GPIO 15
# KI_AMP_BTN_PINS=airplay:5,bt:6,aux:13,usb:4   # hovedkortet uten MCP23017: kildeknappene (BT/AirPlay, RADIO, AUX, USB) til GND
# KI_AMP_LED_PINS=airplay:7,bt:8,aux:10,usb:11  # og ringene deres (via transistor)
# KI_AMP_LED_ACTIVE_LOW=1   # ringene fra 5 V til GPIO (LED − på GPIO-en): full lysstyrke uten transistor
# KI_AMP_AMP_RELAY_ACTIVE_LOW=1   # forsterker-releet er lavt-trigget (klikker når IN går til GND)
# KI_AMP_USBSW_MODE=direct        # USB-switch-releet er lavt-trigget: IN trekkes til GND i pulsen, ellers flytende
KI_AMP_LMS_PORT=9000

# Skjerm: ssd1309_128x64 (2,42", standard) | ssd1306_128x32 (0,91" testskjerm) | ssd1306_128x64 (0,96")
KI_AMP_OLED=ssd1309_128x64
# Skjermtype: oled (over) eller tft = 2,8" SPI TFT 320x240 (KI_AMP_TFT=ili9341|st7789v) med touch. Kalibrering: KI_AMP_TOUCH_CAL=xmin,xmax,ymin,ymax[,swap]
KI_AMP_DISPLAY=oled
KI_AMP_TFT=ili9341
KI_AMP_TOUCH_CAL=200,3900,200,3900
# Eget nivå per kilde (miks) via ALSA softvol – 1 på hovedkortet, 0 på modul-/testoppsett
KI_AMP_LEVELS=0

# Test: potensiometer som volumknapp uten ADC (RC-måling). Tom = av. Eksempel: rc:24
KI_AMP_POT=
