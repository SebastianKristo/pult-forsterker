# Kopieres til /etc/ki-amp.env
KI_AMP_NAME=Pultforsterker
KI_AMP_PORT=8765
# modules = modulbygget (XH-M562 + X9C + relékort), main = KI Pultforsterker hovedkort rev A
KI_AMP_BOARD=modules
RELAY_ACTIVE_LOW=1
# Øvre grense for digitalpot (0-99) ved 100 % volum. 85 = trygt for 6 ohm / 5-40 W-høyttalere på 24 V.
KI_AMP_MAX_TAP=85
# CamillaDSP (loudness/digitalt volum for AirPlay, BT, USB)
KI_AMP_DSP_WS=ws://127.0.0.1:1234
KI_AMP_DSP_CAPTURE=hw:Loopback,1
KI_AMP_DSP_PLAYBACK=hw:sndrpihifiberry
# KI_AMP_DSP_FORMAT=S16LE   # bare i testmodus (KI_AMP_OUT=headphones – 3,5 mm på Pi 4)
# Valgfritt – tom = MQTT av (HA-integrasjonen og Homey-appen trenger det ikke)
MQTT_HOST=
MQTT_USER=
MQTT_PASS=


# Bytt kilde automatisk når AirPlay/Bluetooth begynner å spille (1 = på, 0 = av)
KI_AMP_AUTO_INPUT=1
# 1 = miks digitale kilder (AirPlay, Bluetooth, USB og Radio kan spille samtidig). Kan også slås av/på i HA/Homey.
KI_AMP_MIX=0
# Talemeldinger: en = ferdiginnspilt engelsk AI-stemme (pi/sounds), no = norsk Piper laget på Pi-en
KI_AMP_VOICE_LANG=en

# Lyrion Music Server (radio med kanal 1–6, stasjonsbilder). IP til LMS – tom = finn automatisk.
KI_AMP_LMS_SERVER=
KI_AMP_LMS_PORT=9000

# Skjerm: ssd1309_128x64 (2,42", standard) | ssd1306_128x32 (0,91" testskjerm) | ssd1306_128x64 (0,96")
KI_AMP_OLED=ssd1309_128x64

# Test: potensiometer som volumknapp uten ADC (RC-måling). Tom = av. Eksempel: rc:24
KI_AMP_POT=
