[Unit]
Description=KI Pultforsterker – USB-lyd (Pi som USB-lydkort for PC, full speed) -> DAC
After=sound.target

[Service]
ExecStartPre=/usr/local/bin/ki-usb-gadget.sh
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/alsaloop -C hw:Pultforsterker -P default -r 48000 -t 50000 -S 0
ExecStopPost=/usr/local/bin/ki-usb-gadget.sh stop
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
