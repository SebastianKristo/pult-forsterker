[Unit]
Description=Shairport Sync – AirPlay 2 (Pultforsterker)
After=network-online.target sound.target avahi-daemon.service nqptp.service
Wants=network-online.target avahi-daemon.service
Requires=nqptp.service

[Service]
ExecStart=/usr/local/bin/shairport-sync
User=shairport-sync
Group=audio
RuntimeDirectory=shairport-sync
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
