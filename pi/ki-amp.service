[Unit]
Description=KI Pultforsterker daemon (HTTP-API, mDNS, relé, valgfri MQTT)
After=network-online.target camilladsp.service shairport-sync.service
Wants=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
EnvironmentFile=-/etc/ki-amp.env
ExecStart=/usr/bin/python3 /usr/local/bin/ki_amp_daemon.py
Restart=always
RestartSec=5
User=root
