[Unit]
Description=CamillaDSP (loudness + digitalt volum for Pultforsterker)
After=sound.target
Before=ki-amp.service shairport-sync.service bluealsa-aplay.service ki-usb-audio.service

[Service]
# Starter dempet på −60 dB (--gain=-60 uten mellomrom: «-g -60» tolkes som et ukjent valg og CamillaDSP starter ikke): Skjold (ki-amp) setter riktig volum og slår på lyden. Uten dette spilte CamillaDSP på
# fullt volum (0 dB) etter en omstart til Skjold rakk å sende volumet.
ExecStart=/usr/local/bin/camilladsp --gain=-60 --mute -p 1234 -a 127.0.0.1 -o /var/log/camilladsp.log /etc/camilladsp/config.yml
Restart=always
RestartSec=3
User=root
Nice=-10

[Install]
WantedBy=multi-user.target
