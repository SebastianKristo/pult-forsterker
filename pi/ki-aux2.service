[Unit]
Description=Pultforsterker – AUX 2 (PCM2900 USB-kodek på hovedkortet) -> miks
After=sound.target
# gi aldri opp: USB-kortet kan komme etter oppstart, og alsaloop avslutter ved underrun (f.eks. når CamillaDSP starter på nytt)
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/alsaloop -C hw:CODEC -P aux2 -r 48000 -t 100000 -S 0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
