[Unit]
Description=Pultforsterker – Squeezelite-spiller for Music Assistant (Slimproto)
After=network-online.target sound.target camilladsp.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/ki-amp.env
# -o default: dmix → CamillaDSP (loudness/volum) · -C 5: slipp lydenheten etter 5 s stillhet
# -s KI_AMP_LMS_SERVER (Lyrion) eller KI_AMP_MA_SERVER (Music Assistant): tom = finn serveren automatisk
ExecStart=/bin/sh -c 'exec /usr/bin/squeezelite -n "$${KI_AMP_NAME:-Pultforsterker}" -o default -C 5 -m "$$(cat /sys/class/net/eth0/address 2>/dev/null || echo 00:00:00:00:00:01)" $${KI_AMP_LMS_SERVER:+-s $$KI_AMP_LMS_SERVER} $${KI_AMP_MA_SERVER:+-s $$KI_AMP_MA_SERVER}'
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
