[Unit]
Description=Pultforsterker – Squeezelite-spiller for Lyrion (radio)
After=network-online.target sound.target camilladsp.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/ki-amp.env
# Spiller-ID og argumenter settes i ki-squeezelite-start (unik ID også på Wi-Fi-enheter uten eth0)
ExecStart=/usr/local/bin/ki-squeezelite-start
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
