<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Som Skjold.entitlements, pluss NFC-skriving for «Lag kassett». Krever betalt Apple-utviklerkonto (personlig team
     kan ikke signere CoreNFC). Bytt CODE_SIGN_ENTITLEMENTS til denne fila for å skrive kassetter med telefonen;
     uten den bruker appen Kassett-spilleren i læremodus. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.no.kristo.skjold</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
