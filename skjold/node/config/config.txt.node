# ---------------------------------------------------------------------------
# Skjold Node (OLED-utgave, rev C) – tillegg til /boot/firmware/config.txt
# Legges inn av driver/installer_node.sh (pi-gen stage-skjold / Skjold Flasher).
# Pinnene står i config/node_pins.json – endre der først.
# ---------------------------------------------------------------------------

[all]
# I²C1 (GPIO2/3, pinne 3/5): 0,91" SSD1306 OLED på 0x3C og ADS1115 (potmeter) på 0x48.
# 400 kHz gir ~25 bilder/s på 128×32 uten å stresse ADS1115 (tåler 400 kHz fast mode).
dtparam=i2c_arm=on
dtparam=i2c_arm_baudrate=400000

# SPI AV: GPIO7 (SPI0 CE1) er knappen ▶▶. Med dtparam=spi=on tar spidev pinnen,
# og knappen gir "Device or resource busy". Node har ingen SPI-enheter lenger.
dtparam=spi=off

# Lyd: innebygd 3,5 mm / HDMI. Analog lyd bruker PWM0/PWM1 internt, så
# maskinvare-PWM på GPIO12/13/18/19 er IKKE tilgjengelig. LED-ringene dimmes med
# programvare-PWM (gpiozero). Ikke legg til dtoverlay=pwm/pwm-2chan.
dtparam=audio=on
# NB: GPIO20/21 (I²S PCM_DIN/DOUT) brukes av LED-ringene ◀◀/▶▶. Et I²S-lydkort
# kan ikke brukes uten å flytte dem (se node_pins.json → leds._i2s_merknad).

# Seriekonsoll av (GPIO14/15 ledige, raskere oppstart).
enable_uart=0

# Startnivå før Linux er oppe: LED-ringene av, knappene med pull-up.
# op=utgang, dl=lav, ip=inngang, pu=pull-up
gpio=12,16,20,21=op,dl
gpio=7,23,24,25=ip,pu

# Knappene leses av ki_amp_daemon.py med gpiozero. IKKE legg til gpio-key-
# overlays for de samme pinnene (gir "Device or resource busy").
# Skjermen drives av Skjold OS med luma.oled (ssd1306, I²C 1, 0x3C) – ingen overlay.
